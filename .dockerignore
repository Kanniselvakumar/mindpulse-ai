backend/data/*.db-journal
backend/data/*.db-wal

# Streamlit local secrets
.streamlit/secrets.toml

# IDEs & OS files
.idea/
.vscode/
.DS_Store
Thumbs.db

# Documentation & presentation files (optional to keep image lean)
docs/
*.pdf
Mindpulse logo.png
